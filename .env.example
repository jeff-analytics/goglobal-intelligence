APP_ENV=development
DATABASE_URL=sqlite:///./bordermargin.db
CORS_ORIGINS=http://localhost:5173

# UN Comtrade free API subscription
COMTRADE_SUBSCRIPTION_KEY=

# eBay Browse API
# Use sandbox until Production Browse access is approved.
EBAY_ENV=sandbox
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
EBAY_MARKETPLACE_ID=

VITE_API_BASE=http://localhost:8000

# Optional model API. All fields are user-configured in Data Sources.
AI_PROVIDER=
AI_PROTOCOL=
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=

# Web research is configured separately from the model API.
# auto: provider-native search when available, otherwise Tavily when configured.
WEB_RESEARCH_PROVIDER=auto
TAVILY_API_KEY=
TAVILY_BASE_URL=https://api.tavily.com
